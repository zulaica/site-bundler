{
  "name": "@zulaica/site-bundler",
  "author": "David Zulaica",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "license": "UNLICENSED",
  "bin": {
    "site-bundler": "lib/index.mjs"
  },
  "description": "",
  "main": "./lib/index.mjs",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "/lib"
  ],
  "scripts": {
    "lint": "eslint \"lib/**\"",
    "test": "NODE_ENV=test node --test --test-concurrency=1 --require \"./lib/helpers/tests.mjs\"",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --experimental-test-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zulaica/site-bundler.git"
  },
  "bugs": {
    "url": "https://github.com/zulaica/site-bundler/issues"
  },
  "homepage": "https://github.com/zulaica/site-bundler#readme",
  "dependencies": {
    "@babel/core": "8.0.1",
    "@babel/parser": "8.0.4",
    "@babel/preset-env": "8.0.2",
    "commander": "15.0.0",
    "cssnano": "8.0.2",
    "cssnano-preset-advanced": "8.0.2",
    "htmlnano": "3.4.0",
    "postcss": "8.5.20",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "11.3.2",
    "postcss-url": "10.1.4",
    "posthtml": "0.16.7",
    "posthtml-hash": "1.2.2",
    "rollup": "4.62.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "prettier": "3.9.5"
  },
  "volta": {
    "node": "24.18.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
